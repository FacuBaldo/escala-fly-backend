generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  ENCARGADO
  PILOTO
  AGROPECUARIO
}

enum EstadoAeronave {
  ACTIVA
  EN_MANTENIMIENTO
  INACTIVA
}

enum TipoProducto {
  HERBICIDA
  FUNGICIDA
  INSECTICIDA
  FERTILIZANTE
  COADYUVANTE
  OTRO
}

model Empresa {
  id        String      @id @default(uuid())
  nombre    String
  email     String?
  telefono  String?
  usuarios  Usuario[]
  campos    Campo[]
  productos Producto[]
  Aeronave  Aeronave[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  aeronaves Aeronave[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campo {
  id        String   @id @default(uuid())
  nombre    String
  ubicacion String?
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Aeronave {
  id            String         @id @default(uuid())
  matricula     String         @unique
  modelo        String
  fabricante    String?
  estado        EstadoAeronave @default(ACTIVA)
  observaciones String?
  empresaId     String
  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Usuario {
  id         String   @id @default(uuid())
  nombre     String
  apellido   String
  email      String   @unique
  contrasena String
  rol        Rol      @default(AGROPECUARIO)
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Aeronave {
  id            String         @id @default(uuid())
  matricula     String         @unique
  modelo        String
  fabricante    String?
  estado        EstadoAeronave @default(ACTIVA)
  observaciones String?
  empresaId     String
  Empresa       Empresa        @relation(fields: [empresaId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Producto {
  id           String       @id @default(uuid())
  nombre       String
  marca        String?
  tipo         TipoProducto @default(HERBICIDA)
  unidadMedida String
  descripcion  String?
  empresaId    String
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
